{
  "name": "Peace✘",
  "version": "1.0.0",
  "description": "Peace✘ - Discord bot with moderation, security, server utility and owner features (music moved to the separate 'Peace music' bot)",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "deploy": "node scripts/deploy.js",
    "deploy:guild": "node scripts/guild-sync.js",
    "deploy:guilds": "node scripts/deploy.js --guild-only",
    "deploy:global": "node scripts/deploy.js --pure-global"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1112.0",
    "@aws-sdk/s3-request-presigner": "^3.1112.0",
    "@discordjs/voice": "^0.19.2",
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.15.3",
    "dotenv": "^17.4.2"
  },
  "allowScripts": {
    "protobufjs@7.6.5": true,
    "canvas@3.2.3": true,
    "esbuild@0.27.7": true,
    "better-sqlite3@13.0.3": true
  }
}
