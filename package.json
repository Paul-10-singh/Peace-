{
  "name": "Peace✘",
  "version": "1.0.0",
  "description": "Peace✘ - Discord bot with moderation, security, server utility and owner features (music moved to the separate 'Peace music' bot)",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "deploy": "node scripts/deploy.js",
    "deploy:guild": "node scripts/deploy.js --guild-scope",
    "deploy:guilds": "node scripts/deploy.js --guild-scope",
    "deploy:global": "node scripts/deploy.js --global",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit:deps": "npm audit"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1112.0",
    "@aws-sdk/s3-request-presigner": "^3.1112.0",
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "@distube/direct-link": "^1.0.1",
    "@distube/soundcloud": "^2.0.4",
    "@distube/spotify": "^2.0.2",
    "@distube/yt-dlp": "^2.0.1",
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^13.0.3",
    "bloom-filters": "^3.0.4",
    "discord.js": "^14.15.3",
    "distube": "^5.2.3",
    "dotenv": "^17.4.2",
    "ffmpeg-static": "^5.3.0",
    "ioredis": "^6.0.0",
    "js-yaml": "^5.4.2",
    "libsodium-wrappers": "^0.8.4",
    "pino": "^10.3.1"
  },
  "allowScripts": {
    "protobufjs@7.6.5": true,
    "canvas@3.2.3": true,
    "esbuild@0.27.7": true,
    "better-sqlite3@13.0.3": true
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "vitest": "^2.1.9"
  }
}
