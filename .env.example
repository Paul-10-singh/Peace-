DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_bot_application_id_here
OWNER_ID=your_discord_user_id_here
# Optional: set to a server ID to deploy commands instantly (recommended while testing)
DEV_GUILD_ID=
# Optional: link shown by /support (your support server invite)
SUPPORT_URL=

# Optional: Cloudflare R2 for /backupfiles — used when an archive exceeds Discord's 24 MB DM cap.
# 1) Create a PRIVATE R2 bucket (e.g. "havoc-backups") at https://dash.cloudflare.com -> R2 (free tier: 10 GB)
# 2) R2 -> Manage R2 API Tokens -> Create API token with "Object Read & Write", scoped to that bucket only
# 3) R2_ACCOUNT_ID is shown at the top-right of the R2 dashboard; key/secret shown once when creating the token
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=havoc-backups

# Optional: weekly voice-activity goal (hours) for /vcstats, /vctask and /vchart.
# Members at or above this count as "ACTIVE". Defaults to 10 hours.
VC_WEEKLY_GOAL_HOURS=10