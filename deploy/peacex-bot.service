[Unit]
Description=PeaceX Discord Bot (security platform)
Documentation=https://github.com/anomalyco/opencode
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=peacex
Group=peacex
WorkingDirectory=/opt/peacex
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=5
TimeoutStopSec=15
KillMode=mixed

# ── sandboxing (systemd hardening) ─────────────────────────────
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid
ProtectSystem=strict
ReadWritePaths=/opt/peacex/data /opt/peacex/logs
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
SystemCallFilter=@system-service
SystemCallFilter=~@mount @reboot @swap @obsolete @privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

# ── resource limits ─────────────────────────────────────────────
MemoryMax=512M
TasksMax=256
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target